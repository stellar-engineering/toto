{
  "expo": {
    "name": "Toto",
    "slug": "toto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stellar.toto",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Toto connects to your Toto device on your home network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#11140F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stellar.toto",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFB000",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#11140F"
        }
      ],
      [
        "react-native-ble-manager",
        {
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Toto uses Bluetooth to find and set up a Toto device nearby."
        }
      ]
    ],
    "scheme": "toto",
    "backgroundColor": "#11140F",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af5cfc62-0414-41b1-8387-237d23899ede"
      }
    },
    "owner": "stellar-engineering",
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
